---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingBackControl from '../common/FloatingBackControl.astro';
import WorkflowPipeline from '../common/WorkflowPipeline.astro';
import ConceptIntegration from '../common/ConceptIntegration.astro';
import { getHardwarethonContent } from '../../i18n/hardwarethon';
import type { Locale } from '../../i18n/home';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = getHardwarethonContent(locale);
const home = locale === 'en' ? '/' : `/${locale}/`;
---
<BaseLayout locale={locale} title="Hardwarethon 2019 | Diego Carrillo" description={copy.description}>
  <section class="hardwarethon-page relative isolate overflow-hidden px-6 py-8 sm:px-10 lg:px-16">
    <FloatingBackControl href={`${home}#milestones`} label={copy.back} />
    <article class="case-study mx-auto mt-12 max-w-4xl pb-12 sm:mt-14 sm:pb-14">
      <header>
        <p class="section-eyebrow text-violet-300">{copy.eyebrow}</p>
        <h1 class="interactive-heading page-title mt-5 text-slate-400">
          <span class="sr-only">Hardwarethon.</span>
          <span class="hardwarethon-wordmark" aria-hidden="true"></span>
        </h1>
        <p class="body-copy-reference mt-8 max-w-3xl text-slate-300">{copy.intro}</p>
      </header>
      <dl class="hardwarethon-facts" aria-label={copy.factsLabel}>
        {['3', '48 h', '2019'].map((value, index) => (
          <div><dt>{copy.facts[index]}</dt><dd>{value}</dd></div>
        ))}
      </dl>
      <figure class="hardwarethon-film">
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset="/images/library/milestones/hardwarethon/teamwork-poster.jpg" />
          <img id="hardwarethon-animation" data-hardwarethon-gif src="/images/library/milestones/hardwarethon/teamwork.gif" alt={copy.videoLabel}
            width="560" height="315" loading="lazy" decoding="async" />
        </picture>
        <button class="hardwarethon-motion" type="button" data-motion-toggle data-pause={copy.pauseAnimation} data-play={copy.playAnimation} aria-pressed="false" aria-controls="hardwarethon-animation">{copy.pauseAnimation}</button>
        <figcaption id="hardwarethon-film-caption">
          <a href="https://www.hardwarethon.com/" target="_blank" rel="noopener noreferrer">{copy.videoCaption}</a>
        </figcaption>
      </figure>
      <section class="hardwarethon-section" aria-labelledby="hardwarethon-outcome">
        <p class="section-eyebrow text-violet-300">{copy.outcomeLabel}</p>
        <h2 class="section-title mt-5" id="hardwarethon-outcome">{copy.outcomeTitle}</h2>
        <p class="body-copy-reference mt-6 max-w-3xl text-slate-400">{copy.outcome}</p>
        <div class="hardwarethon-integration">
          <p class="section-eyebrow text-violet-300">{copy.integrationLabel}</p>
          <ConceptIntegration label={copy.integrationLabel} caption={copy.integrationCaption} inputs={copy.inputs} stages={[copy.model, copy.interface, copy.value]} />
        </div>
        <p class="body-copy-reference mt-4 max-w-3xl text-slate-400">{copy.context}</p>
      </section>
      <section class="hardwarethon-section" aria-labelledby="hardwarethon-team">
        <p class="section-eyebrow text-violet-300">{copy.teamLabel}</p>
        <h2 class="section-title mt-5" id="hardwarethon-team">{copy.teamTitle}</h2>
        <p class="body-copy-reference mt-6 max-w-3xl text-slate-400">{copy.teamCopy}</p>
      </section>
      <section class="hardwarethon-section" aria-labelledby="hardwarethon-workflow">
        <p class="section-eyebrow text-violet-300">{copy.workflowLabel}</p>
        <h2 class="section-title mt-5" id="hardwarethon-workflow">{copy.workflowTitle}</h2>
        <WorkflowPipeline label={copy.workflowTitle} steps={copy.steps} />
      </section>
      <footer class="hardwarethon-sources" aria-label={copy.sourcesLabel}>
        <p class="section-eyebrow text-violet-300">{copy.sourcesLabel}</p>
        <div>
          <a class="interactive-control hardwarethon-reference" href="https://www.hardwarethon.com/" target="_blank" rel="noopener noreferrer">
            <span>Hardwarethon 2019</span>
            <svg class="hardwarethon-reference-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg>
          </a>
        </div>
      </footer>
    </article>
  </section>
</BaseLayout>
<style>
  .hardwarethon-wordmark { display: block; height: 1.5rem; aspect-ratio: 479.8 / 52.3; max-width: 100%; background: rgb(196 181 253); mask: url('/images/library/milestones/hardwarethon/hardwarethon-logo.svg') left center / contain no-repeat; }
  :global(html[data-theme="light"]) .hardwarethon-wordmark { background: #3b0764; }
  @media (max-width: 48rem) { .hardwarethon-wordmark { height: 1.35rem; } }
  .hardwarethon-film { margin: 2.5rem 0 0; max-width: 40rem; }
  .hardwarethon-integration { margin-top: 2rem; margin-bottom: 2rem; }
  .hardwarethon-film img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border: 1px solid rgba(196,181,253,.28); border-radius: .85rem; background: transparent; }
  .hardwarethon-motion { display: none; margin-top: .6rem; padding: .2rem 0; color: #c4b5fd; font-size: var(--type-caption-size); cursor: pointer; }
  .hardwarethon-motion:hover { text-decoration: underline; text-underline-offset: .2em; }
  .hardwarethon-motion:focus-visible { outline: 1px solid currentColor; outline-offset: .3rem; }
  :global(html[data-theme="light"]) .hardwarethon-motion { color: #4c1d95; }
  .hardwarethon-film figcaption { margin-top: .65rem; color: rgb(148 163 184); font-size: var(--type-caption-size); line-height: 1.6; }
  .hardwarethon-film a:hover { text-decoration: underline; text-underline-offset: .2em; }
  :global(html[data-theme="light"]) .hardwarethon-film img { border-color: rgba(109,40,217,.22); }
  :global(html[data-theme="light"]) .hardwarethon-film figcaption { color: #475569; }
  .hardwarethon-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2.5rem; }
  .hardwarethon-facts > div { display: flex; flex-direction: column-reverse; gap: .5rem; border-top: 1px solid rgba(196,181,253,.3); padding-top: 1.25rem; }
  .hardwarethon-facts dt { color: rgb(148 163 184); font-size: var(--type-caption-size); line-height: 1.6; overflow-wrap: anywhere; }
  .hardwarethon-facts dd { color: rgb(196 181 253); font-size: clamp(1.75rem, 5vw, 2.75rem); line-height: 1.2; letter-spacing: -.035em; font-weight: 400; }
  .hardwarethon-section { margin-top: clamp(3.5rem, 7vw, 5rem); }
  .hardwarethon-section h2 { color: rgb(196 181 253); font-weight: 600; }
  .hardwarethon-sources { border-top: 1px solid rgba(196,181,253,.2); margin-top: 4rem; padding-top: 1.5rem; }
  .hardwarethon-sources > div { display: flex; justify-content: center; margin-top: 1rem; }
  .hardwarethon-reference { align-items: center; background: #020203; border: 1px solid rgba(221,214,254,.38); border-radius: 999px; color: rgb(226 232 240); display: inline-flex; font-size: var(--type-caption-size); font-weight: 400; gap: 1.4rem; justify-content: space-between; letter-spacing: .15em; min-height: 2.75rem; padding: .65rem .8rem .65rem 1.25rem; text-transform: uppercase; transition: border-color 180ms ease, box-shadow 180ms ease, color 180ms ease, transform 180ms ease; width: fit-content; }
  .hardwarethon-reference-arrow { border: 1px solid rgba(196,181,253,.24); border-radius: 50%; height: 1.75rem; padding: .38rem; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; width: 1.75rem; }
  .hardwarethon-reference:hover, .hardwarethon-reference:focus-visible { border-color: rgba(221,214,254,.78); box-shadow: 0 0 1rem rgba(139,92,246,.15); color: rgb(221 214 254); transform: translateY(-1px); }
  .hardwarethon-reference:focus-visible { outline: 2px solid rgba(196,181,253,.42); outline-offset: 3px; }
  :global(html[data-theme="light"]) .hardwarethon-facts > div,
  :global(html[data-theme="light"]) .hardwarethon-sources { border-color: rgba(109,40,217,.22); }
  :global(html[data-theme="light"]) .hardwarethon-facts dd,
  :global(html[data-theme="light"]) .hardwarethon-section h2 { color: #4c1d95; }
  :global(html[data-theme="light"]) .hardwarethon-reference { background: rgba(76,29,149,.15); border-color: rgba(167,139,250,.42); color: #6d28d9; }
  :global(html[data-theme="light"]) .hardwarethon-facts dt { color: #475569; }
</style>
<script>
  const animation = document.querySelector<HTMLImageElement>('[data-hardwarethon-gif]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  if (animation && toggle) {
    const animatedSource = animation.getAttribute('src')!;
    const poster = '/images/library/milestones/hardwarethon/teamwork-poster.jpg';
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let paused = motion.matches;
    const update = () => {
      animation.src = paused ? poster : animatedSource;
      toggle.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.style.display = motion.matches ? 'none' : 'inline-block';
    };
    toggle.addEventListener('click', () => { paused = !paused; update(); });
    motion.addEventListener('change', () => { if (motion.matches) paused = true; update(); });
    update();
  }
</script>
