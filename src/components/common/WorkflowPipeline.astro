---
interface Props {
  label: string;
  steps: readonly { label: string; title: string; copy: string }[];
}
const { label, steps } = Astro.props;
const paths = [
  'M32 12c-8 0-14 6-14 14 0 6 3 9 7 13v5h14v-5c4-4 7-7 7-13 0-8-6-14-14-14ZM25 50h14M29 55h6M32 5v3M10 26h4M50 26h4',
  'M20 20h24v24H20zM26 27h12v10H26zM26 12v8M38 12v8M26 44v8M38 44v8M12 26h8M12 38h8M44 26h8M44 38h8',
  'M13 15h38v28H13zM32 43v10M23 53h18M22 29l7 7 13-14',
];
---
<ol class="plant-flow" aria-label={label}>
  {steps.map((step, index) => (
    <li>
      <span class="plant-flow-symbol" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={paths[index % paths.length]} /></svg>
      </span>
      <div><span>{step.label}</span><strong>{step.title}</strong><p>{step.copy}</p></div>
    </li>
  ))}
</ol>
