---
interface Node { title: string; detail: string }
interface Props { label: string; caption: string; inputs: readonly Node[]; stages: readonly Node[] }
const { label, caption, inputs, stages } = Astro.props;
const icons = [
  'M20 20h24v24H20zM26 26h12v12H26zM26 12v8M38 12v8M26 44v8M38 44v8M12 26h8M12 38h8M44 26h8M44 38h8',
  'M23 20 11 32l12 12M41 20l12 12-12 12M36 14l-8 36',
  'M12 24 32 13l20 11-20 11-20-11ZM12 33l20 11 20-11M12 42l20 11 20-11',
  'M32 12 14 22v21l18 10 18-10V22L32 12ZM14 22l18 11 18-11M32 33v20M24 18l18 10',
  'M12 15h40v32H12zM12 24h40M19 19h1M25 19h1M20 32h9v8h-9zM35 32h9M35 39h9',
  'M12 48h40M18 48V35h7v13M29 48V27h7v21M40 48V17h7v31M15 25l15-10 10 3 10-9',
];
---
<figure class="concept-integration" data-concept-diagram aria-label={label}>
  <div class="concept-flow" data-concept-flow>
    <svg class="concept-connections" data-concept-connections aria-hidden="true" focusable="false">
      <defs><marker id="integration-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M1 1 7 4 1 7" /></marker></defs>
      <g data-concept-paths></g>
    </svg>
    <div class="concept-inputs">
      {inputs.map((node, index) => <div class="concept-node concept-input" data-concept-input>
        <span class="concept-symbol" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index]} /></svg></span>
        <div class="concept-copy"><span>{node.title}</span><p>{node.detail}</p></div>
      </div>)}
    </div>
    {stages.map((node, index) => <div class="concept-node concept-stage" data-concept-stage>
      <span class="concept-symbol" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index + 3]} /></svg></span>
      <div class="concept-copy"><span>{node.title}</span><p>{node.detail}</p></div>
    </div>)}
  </div>
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .concept-integration { --line: rgba(196,181,253,.5); --title: #c4b5fd; --body: #94a3b8; --ring: rgba(167,139,250,.3); --canvas: #07050b; margin-top: 2rem; background: transparent; }
  .concept-flow { display: grid; grid-template-columns: 1.2fr 1fr .9fr 1fr; gap: 2rem; align-items: center; position: relative; padding-block: .5rem; }
  .concept-connections { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; color: var(--line); }
  .concept-connections :global(path) { fill: none; stroke: currentColor; stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .concept-node { display: flex; flex-direction: column; align-items: flex-start; gap: .85rem; text-align: left; min-width: 0; position: relative; padding: 1.1rem; border: 1px solid var(--ring); border-radius: .8rem; background: var(--canvas); }
  .concept-inputs { display: grid; gap: .9rem; }
  .concept-input { display: grid; grid-template-columns: 2rem minmax(0, 1fr); align-items: start; gap: .75rem; padding: .9rem; }
  .concept-symbol { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; color: var(--title); }
  .concept-symbol svg { display: block; width: 100%; height: 100%; }
  .concept-input .concept-symbol { width: 2rem; height: 2rem; }
  .concept-stage { min-height: 11rem; }
  .concept-copy > span { display: block; color: var(--title); font-size: var(--type-ui-size); line-height: 1.5; font-weight: 400; overflow-wrap: anywhere; }
  .concept-copy > p { color: var(--body); font-size: var(--type-caption-size); line-height: 1.6; margin-top: .35rem; }
  figcaption { color: var(--body); font-size: var(--type-caption-size); line-height: 1.6; margin-top: 1.5rem; }
  :global(html[data-theme="light"]) .concept-integration { --line: rgba(109,40,217,.45); --title: #4c1d95; --body: #475569; --ring: rgba(109,40,217,.25); --canvas: #f1eef5; }
  @media (max-width: 760px) {
    .concept-flow { grid-template-columns: minmax(0, 1fr); gap: 2.75rem; padding-right: 0; }
    .concept-inputs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; align-items: stretch; }
    .concept-input { display: flex; flex-direction: column; align-items: center; gap: .6rem; padding: .8rem .5rem; text-align: center; }
    .concept-input .concept-copy > span { font-size: .8rem; line-height: 1.45; min-height: 2.9em; hyphens: auto; }
    .concept-input .concept-copy > p { font-size: .75rem; line-height: 1.55; overflow-wrap: anywhere; hyphens: auto; }
    .concept-stage { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; min-height: 0; align-items: center; padding: 1.1rem; width: 100%; max-width: 26rem; justify-self: center; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-concept-diagram]').forEach(diagram => {
    const flow = diagram.querySelector<HTMLElement>('[data-concept-flow]')!;
    const svg = diagram.querySelector<SVGSVGElement>('[data-concept-connections]')!;
    const paths = diagram.querySelector<SVGGElement>('[data-concept-paths]')!;
    const inputs = [...diagram.querySelectorAll<HTMLElement>('[data-concept-input]')];
    const stages = [...diagram.querySelectorAll<HTMLElement>('[data-concept-stage]')];
    const mobile = window.matchMedia('(max-width: 760px)');
    function draw() {
      const origin = flow.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${origin.width} ${origin.height}`);
      const block = (node: HTMLElement) => node.getBoundingClientRect();
      const point = (r: DOMRect, side: 'left'|'right'|'top'|'bottom') => ({
        x: (side === 'left' ? r.left - 6 : side === 'right' ? r.right + 6 : r.left + r.width / 2) - origin.left,
        y: (side === 'top' ? r.top - 7 : side === 'bottom' ? r.bottom + 7 : r.top + r.height / 2) - origin.top,
      });
      const curves: string[] = [];
      const target = point(block(stages[0]), mobile.matches ? 'top' : 'left');
      inputs.forEach(node => {
        const from = point(block(node), mobile.matches ? 'bottom' : 'right');
        if (mobile.matches) {
          const middle = (from.y + target.y) / 2;
          curves.push(`M${from.x},${from.y} C${from.x},${middle} ${target.x},${middle} ${target.x},${target.y}`);
        } else {
          const middle = (from.x + target.x) / 2;
          curves.push(`M${from.x},${from.y} C${middle},${from.y} ${middle},${target.y} ${target.x},${target.y}`);
        }
      });
      stages.slice(0,-1).forEach((node,index) => {
        const from = point(block(node), mobile.matches ? 'bottom' : 'right');
        const to = point(block(stages[index+1]), mobile.matches ? 'top' : 'left');
        const middle = mobile.matches ? (from.y+to.y)/2 : (from.x+to.x)/2;
        curves.push(mobile.matches ? `M${from.x},${from.y} C${from.x},${middle} ${to.x},${middle} ${to.x},${to.y}` : `M${from.x},${from.y} C${middle},${from.y} ${middle},${to.y} ${to.x},${to.y}`);
      });
      paths.replaceChildren(...curves.map(d => {
        const path = document.createElementNS('http://www.w3.org/2000/svg','path');
        path.setAttribute('d',d); path.setAttribute('marker-end','url(#integration-arrow)'); return path;
      }));
    }
    const observer = new ResizeObserver(draw);
    [flow,...inputs,...stages].forEach(node => observer.observe(node));
    mobile.addEventListener('change',draw);
    document.fonts.ready.then(draw);
  });
</script>
